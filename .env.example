# 大模型接口配置
OPENAI_API_KEY=请填写你的密钥
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
TEMPERATURE=0.3

# Web 批改系统
EXCEL_FILE=作业批改记录.xlsx
UPLOAD_DIR=uploads
LOG_LEVEL=INFO
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7861
MAX_FILE_SIZE_MB=20

# 公网访问，可选
ENABLE_NGROK=false
NGROK_AUTHTOKEN=

# QQ / OneBot / NapCat 桥接，可选
ENABLE_QQ_BRIDGE=false
QQ_BRIDGE_HOST=0.0.0.0
QQ_BRIDGE_PORT=8088
QQ_COMMAND_PREFIX=#批改
QQ_OPENAI_MODEL=qwen-turbo
QQ_MAX_CHARS=2500
